# Coolify generates this from the domain assigned to the jitsi-web service.
# Set it manually only for a local Docker Compose test.
SERVICE_URL_JITSI_WEB=https://meet.qiplus.com.br

# Keep every image pinned to a tested release. Change only after validation.
QIPLUS_IMAGE_TAG=local
JITSI_IMAGE_VERSION=stable-10888
TZ=America/Sao_Paulo
LOG_LEVEL=info

# The public IPv4 address of the server running JVB. Do not use the domain.
JVB_ADVERTISE_IPS=203.0.113.10
JVB_STUN_SERVERS=stun.l.google.com:19302

# JWT is issued exclusively by the QIPLUS backend. Never expose this secret
# to browsers or commit the production value to Git.
ENABLE_AUTH=1
ENABLE_GUESTS=0
JWT_APP_ID=qiplus
JWT_APP_SECRET=replace-with-a-long-random-secret
JWT_ACCEPTED_ISSUERS=qiplus
JWT_ACCEPTED_AUDIENCES=qiplus

# Generate distinct long random values for these XMPP internal accounts.
JICOFO_COMPONENT_SECRET=replace-with-a-long-random-secret
JICOFO_AUTH_PASSWORD=replace-with-a-long-random-secret
JVB_AUTH_PASSWORD=replace-with-a-long-random-secret
